# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# --- Database ---
# Local Docker: mongodb://localhost:27017/vaultledger
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/vaultledger
MONGO_URI=mongodb://localhost:27017/vaultledger

# --- JWT ---
# Generate strong secrets with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_me_with_a_long_random_value
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption ---
# 32-byte (64 hex char) key for AES-256-GCM field-level encryption
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=replace_me_with_a_64_char_hex_string

# --- MFA ---
MFA_ISSUER=VaultLedger

# --- Rate limiting ---
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# --- Email (password reset) ---
# If SMTP_HOST is left blank, emails are just logged to the server console instead of
# actually sent - useful for local development without a real mail account.
#
# To send real emails via Gmail:
#   1. Enable 2-Step Verification on the sending Google account
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#   3. Use that generated 16-character password below, NOT the normal account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gauchansujal0@gmail.com
SMTP_PASS=replace_me_with_a_gmail_app_password
MAIL_FROM="VaultLedger <gauchansujal0@gmail.com>"
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30

# --- Password policy ---
# Forces periodic password rotation and prevents cycling back to a recently-used password.
PASSWORD_EXPIRY_DAYS=90
PASSWORD_HISTORY_LIMIT=5

# --- IP filtering ---
# Both are comma-separated IP lists. Leave blank to disable (fail open, not fail closed -
# an empty/misconfigured value never accidentally locks everyone out).
# IP_BLOCKLIST: requests from these IPs are rejected app-wide.
# ADMIN_IP_ALLOWLIST: if set, ONLY these IPs may reach /api/admin/* routes at all.
IP_BLOCKLIST=
ADMIN_IP_ALLOWLIST=

# --- eSewa (Nepali payment gateway) - TEST/SANDBOX only ---
# These are eSewa's own publicly-published test credentials, provided by eSewa for any
# developer to integrate against their sandbox. Do NOT put real merchant credentials
# here in this file - only in the real .env, and never commit that file.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/
